# syntax=docker/dockerfile:1
# =============================================================================
# icecream-sheets — MCP image (Cloud Run service: mcp)
#
# Spec: design-docs/deployment-architecture.md + the standing ruling that
# MCP is NEVER behind the API gateway: it has its own direct ingress,
# self-authenticates (Bearer token verified with MCP_AUTH_SECRET), and
# enforces its own, higher rate-limit tier. Its Cloud Run service therefore
# gets its own ingress posture (deploy/services/mcp.yaml): public ingress
# at the platform level, with authentication enforced by the process itself
# (same pattern as the engine's signed-URL validation).
#
# Build context = repo root:
#   docker build -f deploy/Dockerfile.mcp -t icecream-mcp .
#
# Bin: packages/mcp-server/dist/bin/http.js ("serve:http" script) —
# Streamable HTTP MCP, endpoint /mcp, health GET /health.
# PORT: bin reads process.env.PORT (default 8106 local), validates it, and
# passes it to startMcpHttp() — Cloud Run's injected PORT is honored.
# python3: the MCP sandbox (packages/mcp-server/src/sandbox/python.ts)
# requires a `python3` binary on PATH for sandboxed custom functions.
#
# W17b CLOSED: mcp.yaml sets HOST=0.0.0.0 and bin/http.ts passes it to
# startMcpHttp() (default 127.0.0.1 local). Cloud Run probes require
# 0.0.0.0:$PORT; widening is safe with requireAuth + the production
# MCP_AUTH_SECRET from Secret Manager.
# =============================================================================

# ---------- build stage ----------
FROM node:20-bookworm-slim AS build
WORKDIR /app
COPY package.json package-lock.json tsconfig.base.json ./
COPY packages/engine/package.json        packages/engine/package.json
COPY packages/csv-adapter/package.json   packages/csv-adapter/package.json
COPY packages/ods-adapter/package.json   packages/ods-adapter/package.json
COPY packages/xlsb-adapter/package.json  packages/xlsb-adapter/package.json
COPY packages/xlsx-adapter/package.json  packages/xlsx-adapter/package.json
COPY packages/service/package.json       packages/service/package.json
COPY packages/mcp-server/package.json    packages/mcp-server/package.json
COPY packages/gateway/package.json     packages/gateway/package.json
RUN npm ci --no-audit --no-fund
COPY packages/engine/       packages/engine/
COPY packages/csv-adapter/  packages/csv-adapter/
COPY packages/ods-adapter/  packages/ods-adapter/
COPY packages/xlsb-adapter/ packages/xlsb-adapter/
COPY packages/xlsx-adapter/ packages/xlsx-adapter/
COPY packages/service/      packages/service/
COPY packages/mcp-server/   packages/mcp-server/
COPY packages/gateway/        packages/gateway/
# Fresh-build ordering (2026-10-24 deploy wave): mcp-server imports
# @icecream-sheets/gateway/remote, whose declarations only exist after the
# gateway build -- but the gateway build needs mcp-server dist (agentSvc).
# The remote barrel never imports mcp-server (by design), so compile it +
# its closure first; the full gateway build later re-emits identical output.
RUN npm run build --workspace=@icecream-sheets/engine \
 && npm run build --workspace=@icecream-sheets/csv-adapter \
 && npm run build --workspace=@icecream-sheets/ods-adapter \
 && npm run build --workspace=@icecream-sheets/xlsb-adapter \
 && npm run build --workspace=@icecream-sheets/xlsx-adapter \
 && npm run build --workspace=@icecream-sheets/service \
 && npx tsc packages/gateway/src/remote.ts --outDir packages/gateway/dist --rootDir packages/gateway/src --module NodeNext --moduleResolution NodeNext --target ES2022 --declaration --esModuleInterop --skipLibCheck --strict --forceConsistentCasingInFileNames \
 && npm run build --workspace=@icecream-sheets/mcp-server \
 && npm prune --omit=dev --no-audit --no-fund

# ---------- runtime stage ----------
FROM node:20-bookworm-slim AS runtime
RUN apt-get update \
 && apt-get install -y --no-install-recommends ca-certificates python3 python3-venv \
 && rm -rf /var/lib/apt/lists/*
ENV NODE_ENV=production
WORKDIR /app
COPY --from=build --chown=node:node /app/package.json /app/package-lock.json ./
COPY --from=build --chown=node:node /app/node_modules ./node_modules
COPY --from=build --chown=node:node /app/packages ./packages
USER node
EXPOSE 8080
HEALTHCHECK --interval=30s --timeout=5s --start-period=20s \
  CMD node -e "fetch('http://127.0.0.1:'+(process.env.PORT||8080)+'/health').then(r=>{if(!r.ok)process.exit(1)}).catch(()=>process.exit(1))"
CMD ["node", "packages/mcp-server/dist/bin/http.js"]
