# Icecream Sheets web app — build-time environment (Vite).
# Copy to .env.local and fill in. Rebuild after changing.

# API gateway base URL. When set, the web app runs in gateway mode: ALL
# engine/service traffic goes through the gateway with JWT auth.
# VITE_GATEWAY_URL=http://127.0.0.1:8100

# --- Firebase Google sign-in (Cycle 9) ---
# Google provider ONLY — no username/password.
# Create a Firebase project, enable the Google sign-in provider, register
# this web app, and paste the web config values below.
# The gateway side needs FIREBASE_PROJECT_ID set to the same project id
# (it verifies the Firebase ID token's signature itself).
# VITE_FIREBASE_API_KEY=
# VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
# VITE_FIREBASE_PROJECT_ID=your-project
# VITE_FIREBASE_APP_ID=1:1234567890:web:abcdef1234567890
# VITE_FIREBASE_MEASUREMENT_ID=
